{
  "name": "ski-run",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-only downhill ski game: timed gate course, procedural slope, deterministic physics",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=high",
    "prepare": "[ -n \"$CI\" ] || git config core.hooksPath .husky",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#dist\" \"#coverage\"",
    "fallow:audit": "fallow audit",
    "fallow:health": "fallow health --score --hotspots",
    "fallow:dead-code": "fallow dead-code"
  },
  "dependencies": {
    "simplex-noise": "^4.0.3",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "fallow": "^3.41.0",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
